# Ambiente local (ver docker-compose.yml na raiz do monorepo)
# Use o usuario configurado no Compose e a senha definida em POSTGRES_PASSWORD.
DATABASE_URL="postgresql://<db_user>:<db_password>@localhost:5432/marmoteiro?schema=public"
# Opcional: conexão direta para migrações quando DATABASE_URL usa pool remoto.
DIRECT_DATABASE_URL=""

REDIS_HOST="localhost"
REDIS_PORT=6379
# Redis é opcional; não há consumidor BullMQ nesta etapa (ADR 0003).
DATABASE_POOL_MAX=3

PORT=3001

# Gere um segredo aleatório de pelo menos 32 caracteres e copie no BFF.
ADMIN_API_SECRET=""
HOST=127.0.0.1

# Envio real: manter false até homologar pagamento, credenciais e templates.
COMMUNICATIONS_ENABLED=false
OUTBOX_RUNNER=scheduled
# Chave exclusiva do executor de jobs; não reutilize ADMIN_API_SECRET.
OUTBOX_TRIGGER_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# OAuth offline da conta autorizada; não usar conta de serviço sem delegação.
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_REMINDER_TEMPLATE=""
# Versão suportada no aplicativo Meta, no formato vNN.N.
WHATSAPP_GRAPH_VERSION=""
CONSULTATION_REMINDER_MINUTES=1440,60
